# =============================================================================
# Targeted Acquisition — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# --- LLM (OpenAI-compatible endpoint) ---
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
# Optional: extra headers as JSON (e.g. for custom auth proxies)
# LLM_EXTRA_HEADERS={"X-Custom-Header": "value"}

# --- Search Providers ---
# Google Custom Search (optional if using Tavily)
GOOGLE_API_KEY=
CX_KEY=

# Tavily Search (default provider)
TAVILY_API_KEY=your-tavily-key

# --- Storage (for uploading run outputs) ---
# Backend: "local" (default) or "s3"
STORAGE_BACKEND=local
STORAGE_UPLOAD=false
STORAGE_UPLOAD_DIR=results

# S3-compatible storage (only needed if STORAGE_BACKEND=s3)
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
STORAGE_REGION=us-east-1
STORAGE_BUCKET=your-bucket-name

# --- Infrastructure ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- API Server ---
# Leave empty to disable auth (open access)
API_KEY=
# JSON list of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000"]
# Include the underlying exception in API error responses. Off by default:
# error text can carry absolute paths, a Redis URL with credentials, and raw
# S3 error bodies. The cause is written to the server log either way.
DEBUG_ERRORS=false

# --- Frontend ---
# NOTE: REACT_APP_* values are inlined into the public JS bundle at build time,
# so REACT_APP_API_KEY is readable by anyone who loads the page. Fine for a local
# run; it is not a secret and does not protect a shared deployment. See README
# "Exposure".
REACT_APP_API_URL=http://localhost:8000
REACT_APP_API_KEY=
