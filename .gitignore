# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Environment
.env
venv/
.venv/

# Developer notes / scratchpads
src/notes.txt
notes.txt

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Results / outputs
results/
*.parquet
*.jsonl

# Crawl policy cache. Generated at runtime, never shipped: reasoning.jsonl
# records the domains a run searched, so committing it would publish the
# operator's search history.
src/processing/crawl_policy/allowed.txt
src/processing/crawl_policy/not_allowed.txt
src/processing/crawl_policy/reasoning.jsonl
src/processing/crawl_policy/malformed_lines.log

# Redis
dump.rdb

# Frontend
frontend/build/
frontend/node_modules/
frontend/package-lock.json

# Logs
*.log

# OS
Thumbs.db

# Marker written by `make dev`/`make backend` when make itself started Redis,
# so teardown never shuts down a Redis it does not own.
.dev-redis-started
